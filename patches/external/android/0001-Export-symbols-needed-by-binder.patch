 /**
  * security_binder_transfer_file() - Check if a binder file xfer is allowed
@@ -1081,6 +1084,7 @@ int security_binder_transfer_file(const struct cred *from,
 {
 	return call_int_hook(binder_transfer_file, from, to, file);
