From 77960e65b92a7faf88963833d8fc6d421de7be91 Mon Sep 17 00:00:00 2001
From: Robert Nelson <robertcnelson@gmail.com>
Date: Mon, 11 Nov 2024 15:12:33 -0600
Subject: [PATCH] ite-it66121: RGB666 enablement

Signed-off-by: Robert Nelson <robertcnelson@gmail.com>
---
 .../devicetree/bindings/display/bridge/ite,it66121.yaml       | 1 +
 drivers/gpu/drm/bridge/ite-it66121.c                          | 4 +++-
 2 files changed, 4 insertions(+), 1 deletion(-)

diff --git a/Documentation/devicetree/bindings/display/bridge/ite,it66121.yaml b/Documentation/devicetree/bindings/display/bridge/ite,it66121.yaml
index a7eb2603691f..5f8f07c185fc 100644
--- a/Documentation/devicetree/bindings/display/bridge/ite,it66121.yaml
+++ b/Documentation/devicetree/bindings/display/bridge/ite,it66121.yaml
@@ -63,6 +63,7 @@ properties:
                   Endpoint bus width.
                 enum:
                   - 12  # 12 data lines connected and dual-edge mode
+                  - 18  # 18 data lines connected and single-edge mode
                   - 24  # 24 data lines connected and single-edge mode
                 default: 24
 
diff --git a/drivers/gpu/drm/bridge/ite-it66121.c b/drivers/gpu/drm/bridge/ite-it66121.c
index 925e42f46cd8..1e79ebc28b0f 100644
--- a/drivers/gpu/drm/bridge/ite-it66121.c
+++ b/drivers/gpu/drm/bridge/ite-it66121.c
@@ -712,6 +712,8 @@ static u32 *it66121_bridge_atomic_get_input_bus_fmts(struct drm_bridge *bridge,
 	if (ctx->bus_width == 12)
 		/* IT66121FN Datasheet specifies Little-Endian ordering */
 		input_fmts[0] = MEDIA_BUS_FMT_RGB888_2X12_LE;
+	else if (ctx->bus_width == 18)
+		input_fmts[0] = MEDIA_BUS_FMT_RGB666_1X18;
 	else
 		/* TOFIX support more input bus formats in 24bit width */
 		input_fmts[0] = MEDIA_BUS_FMT_RGB888_1X24;
@@ -1531,7 +1533,7 @@ static int it66121_probe(struct i2c_client *client)
 	of_property_read_u32(ep, "bus-width", &ctx->bus_width);
 	of_node_put(ep);
 
-	if (ctx->bus_width != 12 && ctx->bus_width != 24)
+	if (ctx->bus_width != 12 && ctx->bus_width != 18 && ctx->bus_width != 24)
 		return -EINVAL;
 
 	ep = of_graph_get_remote_node(dev->of_node, 1, -1);
-- 
