From 8b1ca167d106c3928adba26d3b480e4e14cf866c Mon Sep 17 00:00:00 2001
From: Robert Nelson <robertcnelson@gmail.com>
Date: Mon, 7 Jul 2025 15:12:05 -0500
Subject: [PATCH] cpufreq: add ti,j722s support

Signed-off-by: Robert Nelson <robertcnelson@gmail.com>
---
 drivers/cpufreq/cpufreq-dt-platdev.c |  1 +
 drivers/cpufreq/ti-cpufreq.c         | 33 ++++++++++++++++++++++++++++
 2 files changed, 34 insertions(+)

diff --git a/drivers/cpufreq/cpufreq-dt-platdev.c b/drivers/cpufreq/cpufreq-dt-platdev.c
index 015dd393eaba..eba77035eb91 100644
--- a/drivers/cpufreq/cpufreq-dt-platdev.c
+++ b/drivers/cpufreq/cpufreq-dt-platdev.c
@@ -189,6 +189,7 @@ static const struct of_device_id blocklist[] __initconst = {
 	{ .compatible = "ti,am625", },
 	{ .compatible = "ti,am62a7", },
 	{ .compatible = "ti,am62p5", },
+	{ .compatible = "ti,j722s", },
 
 	{ .compatible = "qcom,ipq5332", },
 	{ .compatible = "qcom,ipq6018", },
diff --git a/drivers/cpufreq/ti-cpufreq.c b/drivers/cpufreq/ti-cpufreq.c
index 9a912d309315..d56e38de3784 100644
--- a/drivers/cpufreq/ti-cpufreq.c
+++ b/drivers/cpufreq/ti-cpufreq.c
@@ -48,6 +48,12 @@
 #define AM625_SUPPORT_S_MPU_OPP			BIT(1)
 #define AM625_SUPPORT_T_MPU_OPP			BIT(2)
 
+#define J722S_EFUSE_W_MPU_OPP			23
+#define J722S_EFUSE_X_MPU_OPP			24
+
+#define J722S_SUPPORT_J_MPU_OPP			BIT(0)
+#define J722S_SUPPORT_K_MPU_OPP			BIT(1)
+
 enum {
 	AM62A7_EFUSE_M_MPU_OPP =		13,
 	AM62A7_EFUSE_N_MPU_OPP,
@@ -209,6 +215,22 @@ static unsigned long am625_efuse_xlate(struct ti_cpufreq_data *opp_data,
 	return calculated_efuse;
 }
 
+static unsigned long j722s_efuse_xlate(struct ti_cpufreq_data *opp_data,
+				       unsigned long efuse)
+{
+	unsigned long calculated_efuse = J722S_SUPPORT_J_MPU_OPP;
+
+	switch (efuse) {
+	case J722S_EFUSE_X_MPU_OPP:
+		calculated_efuse |= J722S_SUPPORT_K_MPU_OPP;
+		fallthrough;
+	case J722S_EFUSE_W_MPU_OPP:
+		calculated_efuse |= J722S_SUPPORT_J_MPU_OPP;
+	}
+
+	return calculated_efuse;
+}
+
 static struct ti_cpufreq_soc_data am3x_soc_data = {
 	.efuse_xlate = amx3_efuse_xlate,
 	.efuse_fallback = AM33XX_800M_ARM_MPU_MAX_FREQ,
@@ -311,6 +333,7 @@ static const struct soc_device_attribute k3_cpufreq_soc[] = {
 	{ .family = "AM62AX", .revision = "SR1.0" },
 	{ .family = "AM62PX", .revision = "SR1.0" },
 	{ .family = "AM62DX", .revision = "SR1.0" },
+	{ .family = "J722S", .revision = "SR1.0" },
 	{ /* sentinel */ }
 };
 
@@ -339,6 +362,15 @@ static struct ti_cpufreq_soc_data am62p5_soc_data = {
 	.multi_regulator = false,
 };
 
+static struct ti_cpufreq_soc_data j722s_soc_data = {
+	.efuse_xlate = j722s_efuse_xlate,
+	.efuse_offset = 0x0018,
+	.efuse_mask = 0x07c0,
+	.efuse_shift = 0x6,
+	.multi_regulator = false,
+	.quirks = TI_QUIRK_SYSCON_IS_SINGLE_REG,
+};
+
 /**
  * ti_cpufreq_get_efuse() - Parse and return efuse value present on SoC
  * @opp_data: pointer to ti_cpufreq_data context
@@ -460,6 +492,7 @@ static const struct of_device_id ti_cpufreq_of_match[]  __maybe_unused = {
 	{ .compatible = "ti,am62a7", .data = &am62a7_soc_data, },
 	{ .compatible = "ti,am62d2", .data = &am62a7_soc_data, },
 	{ .compatible = "ti,am62p5", .data = &am62p5_soc_data, },
+	{ .compatible = "ti,j722s", .data = &j722s_soc_data, },
 	/* legacy */
 	{ .compatible = "ti,omap3430", .data = &omap34xx_soc_data, },
 	{ .compatible = "ti,omap3630", .data = &omap36xx_soc_data, },
-- 
2.51.0

