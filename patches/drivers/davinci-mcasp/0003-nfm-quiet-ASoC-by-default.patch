From 0ac02bd2c70b9fad8fc8e1ea59f01931067d3312 Mon Sep 17 00:00:00 2001
From: Robert Nelson <robertcnelson@gmail.com>
Date: Tue, 13 Jan 2026 13:57:29 -0600
Subject: [PATCH 3/3] [nfm] quiet ASoC by default

Signed-off-by: Robert Nelson <robertcnelson@gmail.com>
---
 sound/soc/soc-utils.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/sound/soc/soc-utils.c b/sound/soc/soc-utils.c
index c8adfff826bd..5674874470d3 100644
--- a/sound/soc/soc-utils.c
+++ b/sound/soc/soc-utils.c
@@ -35,7 +35,7 @@ int snd_soc_ret(const struct device *dev, int ret, const char *fmt, ...)
 		vaf.fmt = fmt;
 		vaf.va = &args;
 
-		dev_err(dev, "ASoC error (%d): %pV", ret, &vaf);
+		dev_dbg(dev, "ASoC error (%d): %pV", ret, &vaf);
 	}
 
 	return ret;
