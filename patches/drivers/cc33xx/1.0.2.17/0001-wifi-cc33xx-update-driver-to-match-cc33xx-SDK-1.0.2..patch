+{
+	struct cc33xx *cc = dev_get_drvdata(dev);
+	unsigned int value;
+	int ret;
+
+	ret = kstrtouint(buf, 10, &value);
+	if (ret < 0)
+		return ret;
+
+	if (value != 0 && value != 1) {
+		cc33xx_warning("invalid WoWLAN ARP offload value %u (must be 0 or 1)", value);
